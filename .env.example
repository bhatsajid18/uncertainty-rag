# Copy to .env and fill in. .env is gitignored: never commit real keys.

# --- LLM providers (at least one) ------------------------------------------------
# Groq: https://console.groq.com/keys  (fast; default for chat)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey  (vision for figures; batch jobs)
GEMINI_API_KEY=

# Default provider for every script and the API: groq | gemini
RAG_PROVIDER=groq
# Model id; empty = the provider's free-tier default
RAG_MODEL=

# --- API server (src/api) --------------------------------------------------------
RAG_DATA_DIR=data
RAG_RESULTS_DIR=results
# dense | bm25 | hybrid | hybrid_rerank
RAG_MODE=hybrid_rerank
# Smaller reranker for low-memory machines (~80 MB instead of ~1.1 GB):
# RAG_RERANKER=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKER=BAAI/bge-reranker-base
RAG_K=5
RAG_MAX_SESSIONS=50
# seconds of inactivity before a chat session is dropped
RAG_SESSION_TTL=3600
RAG_MAX_UPLOADS=5
# 1 = load the models in the background from startup; 0 = on the first request
RAG_WARM_START=1
# Web pages on other origins that may call the API from a browser, comma-
# separated. Empty = none: the Streamlit app calls the API from its server.
RAG_CORS_ORIGINS=

# --- UI (src/ui) -------------------------------------------------------------------
API_URL=http://localhost:8000
API_TIMEOUT=180

# --- rate-limit tuning (rarely needed) -----------------------------------------------
# waits longer than this (seconds) stop with a message instead of sleeping
GROQ_MAX_WAIT=90
# seconds between Gemini requests (free tier: ~10 per minute)
GEMINI_MIN_INTERVAL=6.5
