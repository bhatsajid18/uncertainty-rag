# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/

# Data and models — never commit these (large, and PDFs are copyrighted)
data/papers/
# Figures extracted from the papers are that same copyrighted content, and 3.8
# MB of binaries besides. Regenerate with: python src/rag/figures.py
data/figures/
data/chunk_config.json
data/*.faiss
data/*.jsonl
data/metadata.json
data/chunk_meta.json
data/index_config.json
.cache/

# Model checkpoints
*.pt
*.pth
*.ckpt
*.pkl
checkpoints/

# Uncertainty benchmark: the datasets torchvision downloads, the raw per-image
# predictions (~16 MB; they come in the Kaggle zip) and the fake-data smoke
# run. The summary, CSVs, report and figures ARE committed - the dashboard and
# the README read them.
data/torchvision/
results/uncertainty/**/predictions/
results/uncertainty/fake/
*.zip

# Evaluation runs are committed SELECTIVELY, because per_query.jsonl reaches
# ~1 MB per run and early runs were scored on a query set too small to mean
# anything. Add a run deliberately:  git add -f results/eval/<run-name>
results/eval/*
# Same for answer-quality runs:  git add -f results/gen_eval/<run-name>
results/gen_eval/*

# Experiment tracking / outputs
wandb/
outputs/
logs/
multirun/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp
